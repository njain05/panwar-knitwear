---
import { company, primaryPhone, telHref } from '../data/site';

/* Anchor-only nav. Every target exists on this page — rule 9. */
const nav = [
  { label: 'Top wear', href: '#zonixa' },
  { label: 'Bottom wear', href: '#msp-sports' },
  { label: "Boys' wear", href: '#boys-wear' },
  { label: 'Fabrics', href: '#fabrics' },
  { label: 'Verify us', href: '#trust' },
];
---

<header class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur-sm">
  <div class="mx-auto flex w-full max-w-6xl items-center gap-4 px-5 py-3 sm:px-8">
    <a href="#main" class="flex min-h-11 shrink-0 flex-col justify-center leading-none">
      <span class="text-base font-semibold tracking-tight sm:text-lg">{company.name}</span>
      <span class="mt-0.5 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-ink-muted">
        {company.city}, {company.state}
      </span>
    </a>

    <nav aria-label="Sections" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="tap rounded-sm px-3 text-sm font-medium text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={telHref(primaryPhone.e164)}
      class="tap ml-auto shrink-0 gap-2 rounded-sm border border-line-strong px-3 font-mono text-xs text-ink transition-colors hover:bg-surface-2 lg:ml-0"
    >
      <span aria-hidden="true">☎</span>
      <span class="hidden sm:inline">{primaryPhone.display}</span>
      <span class="sm:hidden">Call</span>
    </a>
  </div>
</header>
