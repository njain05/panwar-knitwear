---
import { Image } from 'astro:assets';
import type { Product } from '../data/site';

interface Props {
  product: Product;
  /** First card in a section is loaded eagerly; the rest lazily. */
  priority?: boolean;
  class?: string;
}
const { product, priority = false, class: cls = '' } = Astro.props;
---

<figure class={`card-hover group flex flex-col rounded-xl border border-line bg-paper p-2 ${cls}`}>
  <div class="relative overflow-hidden rounded-lg bg-surface-2">
    <Image
      src={product.image}
      alt={product.alt}
      widths={[320, 480, 720, 960]}
      sizes="(min-width: 1024px) 320px, (min-width: 640px) 45vw, 90vw"
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      class="aspect-[4/5] w-full object-cover"
    />
  </div>
  <figcaption class="flex flex-col gap-1 px-1.5 pb-1 pt-3">
    <span class="text-sm font-medium leading-snug text-ink">{product.name}</span>
    {
      product.catalogueSheet && (
        <span class="font-mono text-[0.625rem] uppercase tracking-widest text-ink-faint">
          Catalogue sheet
        </span>
      )
    }
  </figcaption>
</figure>
