---
import { Image } from 'astro:assets';
import {
  brands,
  garmentTypes,
  zonixaProducts,
  mspProducts,
  boysProducts,
  listingCounts,
} from '../data/site';

/*
 * The first decision a bulk buyer makes is "do they make my category", so this is
 * the first thing under the fold: three routes, one click each.
 *
 * Everything here is derived — the garment lists, the photographs and the listing
 * counts all come from site.ts, so a card cannot drift out of step with the section
 * it points at.
 */

const countFor = (categories: readonly string[]) =>
  listingCounts
    .filter((l) => categories.includes(l.category))
    .reduce((total, l) => total + l.count, 0);

const routes = [
  {
    href: '#zonixa',
    label: brands.zonixa.name,
    scope: brands.zonixa.scope,
    garments: garmentTypes.zonixa,
    image: zonixaProducts[0]!.image,
    alt: zonixaProducts[0]!.alt,
    listings: countFor([
      "Men's T-shirts",
      'Sweatshirts',
      "Men's half-sleeve tees",
      "Men's round-neck tees",
    ]),
  },
  {
    href: '#msp-sports',
    label: brands.msp.name,
    scope: brands.msp.scope,
    garments: garmentTypes.msp,
    image: mspProducts[0]!.image,
    alt: mspProducts[0]!.alt,
    listings: countFor(["Men's & boys' lowers", "Men's shorts", "Men's lowers"]),
  },
  {
    href: '#boys-wear',
    label: "Boys' wear",
    scope: 'Lowers and joggers',
    garments: garmentTypes.boys,
    image: boysProducts[0]!.image,
    alt: boysProducts[0]!.alt,
    listings: countFor(["Boys' lowers"]),
  },
];
---

<section id="ranges" class="border-t border-line bg-paper">
  <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-16 lg:py-20">
    <header class="rise flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow flex items-center gap-2.5 text-brand-bright">
          <span aria-hidden="true" class="h-px w-7 bg-brand-bright/60"></span>
          Three ranges
        </p>
        <h2 class="mt-3.5 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
          Go straight to your category.
        </h2>
      </div>
      <p class="max-w-sm text-pretty text-sm leading-relaxed text-ink-muted">
        Tops, bottoms and boys' wear are made in the same unit. Anything you combine
        ships on one order.
      </p>
    </header>

    <ul class="rise mt-9 grid gap-4 sm:grid-cols-3 sm:gap-5">
      {
        routes.map((r, i) => (
          <li>
            <a
              href={r.href}
              class="brand-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface"
              style={`--d:${i * 70}ms`}
            >
              <span class="relative block overflow-hidden">
                <Image
                  src={r.image}
                  alt={r.alt}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 640px) 33vw, 92vw"
                  loading="lazy"
                  class="aspect-[5/4] w-full object-cover"
                />
                <span
                  aria-hidden="true"
                  class="brand-card-veil absolute inset-0 bg-gradient-to-t from-brand-deepest/85 via-brand-deepest/10 to-transparent"
                ></span>
                <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4">
                  <span>
                    <span class="block font-mono text-[0.625rem] uppercase tracking-[0.14em] text-white/70">
                      {r.scope}
                    </span>
                    <span class="mt-1 block text-xl font-semibold leading-tight text-white">
                      {r.label}
                    </span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="brand-card-arrow grid size-9 shrink-0 place-items-center rounded-full bg-white/95 text-brand-deepest"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.25"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-4"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </span>
              </span>

              <span class="flex flex-1 flex-col gap-3 p-4">
                <span class="flex flex-wrap gap-1.5">
                  {r.garments.slice(0, 4).map((g) => (
                    <span class="rounded-full border border-brand-tint-line bg-brand-tint px-2.5 py-1 font-mono text-[0.6875rem] text-ink-muted">
                      {g}
                    </span>
                  ))}
                  {r.garments.length > 4 && (
                    <span class="rounded-full px-1 py-1 font-mono text-[0.6875rem] text-ink-faint">
                      +{r.garments.length - 4} more
                    </span>
                  )}
                </span>
                <span class="mt-auto font-mono text-[0.6875rem] text-ink-faint">
                  {r.listings} listings published
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
