---
import { primaryPhone, telHref, whatsappHref } from '../data/site';

/*
 * Narrow viewports only. Buyers arrive here from IndiaMART and WhatsApp on a
 * phone, so Call and WhatsApp stay reachable on every screen without scrolling
 * back. Pure CSS — no JavaScript involved.
 */
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-tint-line bg-paper/95 shadow-[0_-8px_24px_-16px_hsl(var(--pk-shadow)/0.45)] backdrop-blur-md lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="mx-auto flex w-full max-w-6xl gap-2 px-4 py-2.5">
    <a
      href={telHref(primaryPhone.e164)}
      class="btn tap flex-1 gap-2 rounded-md border border-line-strong bg-paper text-sm font-semibold text-ink"
    >
      Call
    </a>
    <a
      href={whatsappHref(primaryPhone.e164)}
      rel="noopener"
      class="btn tap flex-1 gap-2 rounded-md bg-whatsapp text-sm font-semibold text-whatsapp-ink"
    >
      WhatsApp
    </a>
  </div>
</div>
