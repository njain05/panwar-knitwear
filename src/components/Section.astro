---
interface Props {
  id: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  tone?: 'paper' | 'surface';
  class?: string;
}
const { id, eyebrow, title, lede, tone = 'paper', class: cls = '' } = Astro.props;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-paper';
---

<section id={id} class={`${bg} border-t border-line ${cls}`}>
  <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
    {
      (eyebrow || title || lede) && (
        <header class="max-w-2xl">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && (
            <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
              {title}
            </h2>
          )}
          {lede && <p class="mt-4 text-pretty text-base leading-relaxed text-ink-muted sm:text-lg">{lede}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
