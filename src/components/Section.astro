---
interface Props {
  id: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  tone?: 'paper' | 'surface' | 'tint';
  class?: string;
}
const { id, eyebrow, title, lede, tone = 'paper', class: cls = '' } = Astro.props;
const bg =
  tone === 'surface' ? 'bg-surface' : tone === 'tint' ? 'bg-brand-tint' : 'bg-paper';
const line = tone === 'tint' ? 'border-brand-tint-line' : 'border-line';
---

<section id={id} class={`${bg} border-t ${line} ${cls}`}>
  <div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
    {
      (eyebrow || title || lede) && (
        <header class="rise max-w-2xl">
          {eyebrow && (
            <p class="eyebrow flex items-center gap-2.5 text-brand-bright">
              <span aria-hidden="true" class="h-px w-7 bg-brand-bright/60" />
              {eyebrow}
            </p>
          )}
          {title && (
            <h2 class="mt-3.5 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
              {title}
            </h2>
          )}
          {lede && (
            <p class="mt-4 text-pretty text-base leading-relaxed text-ink-muted sm:text-lg">
              {lede}
            </p>
          )}
        </header>
      )
    }
    <slot />
  </div>
</section>
