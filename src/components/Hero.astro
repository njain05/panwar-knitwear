---
import { Image } from 'astro:assets';
import { company, brands, fabrics, zonixaProducts, mspProducts } from '../data/site';
import ContactButtons from './ContactButtons.astro';

/*
 * The USP is "tops and bottoms from one supplier", so the hero shows one
 * photograph from each brand rather than a single decorative image. The pairing
 * is the argument.
 */
const topShot = zonixaProducts[0]!;
const bottomShot = mspProducts[0]!;
---

<div class="border-b border-line bg-paper">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14 lg:py-24">
    <div>
      <p class="eyebrow">
        {company.natureOfBusiness} · {company.city}, {company.state} · Est. {company.established}
      </p>

      <h1 class="mt-5 text-balance text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
        Knitted top wear and bottom wear, from one supplier.
      </h1>

      <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-ink-muted">
        {company.name} manufactures t-shirts, sweatshirts and hoodies under
        <strong class="font-semibold text-ink">{brands.zonixa.name}</strong>, and lowers, track pants,
        nikkar and shorts under <strong class="font-semibold text-ink">{brands.msp.name}</strong>. Both
        are in-house brands. {fabrics.length} knitted fabrics, one purchase order, one dispatch.
      </p>

      <p class="mt-4 max-w-xl text-pretty leading-relaxed text-ink-muted">
        Wholesale and bulk supply, shipped by road across India.
      </p>

      <ContactButtons class="mt-8" />

      <p class="mt-4 font-mono text-xs leading-relaxed text-ink-faint">
        Tell us the garment, the fabric and the quantity — we will quote.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <figure class="flex flex-col">
        <div class="overflow-hidden rounded-sm border border-line bg-surface-2">
          <Image
            src={topShot.image}
            alt={topShot.alt}
            widths={[300, 480, 640]}
            sizes="(min-width: 1024px) 280px, 45vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <figcaption class="mt-2.5">
          <span class="eyebrow">{brands.zonixa.name}</span>
          <span class="mt-1 block text-sm text-ink-muted">{brands.zonixa.scope}</span>
        </figcaption>
      </figure>

      <figure class="flex flex-col sm:mt-8">
        <div class="overflow-hidden rounded-sm border border-line bg-surface-2">
          <Image
            src={bottomShot.image}
            alt={bottomShot.alt}
            widths={[300, 480, 640]}
            sizes="(min-width: 1024px) 280px, 45vw"
            loading="eager"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <figcaption class="mt-2.5">
          <span class="eyebrow">{brands.msp.name}</span>
          <span class="mt-1 block text-sm text-ink-muted">{brands.msp.scope}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</div>
