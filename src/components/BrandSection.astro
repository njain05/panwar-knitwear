---
import type { Product } from '../data/site';
import ProductCard from './ProductCard.astro';
import Section from './Section.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede: string;
  /** Named garment types a buyer can quote back to them. */
  garments: readonly string[];
  products: readonly Product[];
  /** Only set where the brand has its own live site. Never a dead link — rule 9. */
  brandUrl?: string | null;
  brandName?: string;
  tone?: 'paper' | 'surface' | 'tint';
}

const { id, eyebrow, title, lede, garments, products, brandUrl, brandName, tone = 'paper' } =
  Astro.props;
---

<Section id={id} eyebrow={eyebrow} title={title} lede={lede} tone={tone}>
  <ul class="rise mt-7 flex flex-wrap gap-2">
    {
      garments.map((g) => (
        <li class="rounded-full border border-brand-tint-line bg-brand-tint px-3.5 py-1.5 font-mono text-xs text-ink-muted">
          {g}
        </li>
      ))
    }
  </ul>

  <div class="rise mt-10 grid grid-cols-2 gap-x-4 gap-y-6 sm:gap-x-5 lg:grid-cols-4">
    {products.map((p) => <ProductCard product={p} />)}
  </div>

  {
    brandUrl && brandName && (
      <p class="rise mt-8">
        <a
          href={brandUrl}
          rel="noopener"
          class="btn tap gap-2 rounded-md bg-brand-bright px-5 text-sm font-semibold text-brand-ink hover:brightness-110"
        >
          {brandName} brand site
          <span aria-hidden="true">↗</span>
        </a>
      </p>
    )
  }
</Section>
