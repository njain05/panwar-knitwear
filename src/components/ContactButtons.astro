---
import { primaryPhone, telHref, whatsappHref } from '../data/site';

interface Props {
  /** `lg` for the hero and enquiry section, `sm` for the sticky bar. */
  size?: 'sm' | 'lg';
  /** Set when the buttons sit on the violet plate, which needs a light Call button. */
  onPlate?: boolean;
  class?: string;
}
const { size = 'lg', onPlate = false, class: cls = '' } = Astro.props;
const pad = size === 'lg' ? 'px-6 text-base' : 'px-4 text-sm';
const callSkin = onPlate
  ? 'border border-white/30 bg-white/10 text-white hover:bg-white/20'
  : 'border border-line-strong bg-paper text-ink hover:bg-surface-2';
---

<div class={`flex flex-wrap gap-3 ${cls}`}>
  <a
    href={whatsappHref(primaryPhone.e164)}
    rel="noopener"
    class={`btn tap ${pad} flex-1 gap-2 rounded-md bg-whatsapp font-semibold text-whatsapp-ink shadow-sm hover:brightness-110 sm:flex-none`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-[1.15em] shrink-0 fill-current">
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"
      ></path>
    </svg>
    WhatsApp
  </a>
  <a
    href={telHref(primaryPhone.e164)}
    class={`btn tap ${pad} ${callSkin} flex-1 gap-2 rounded-md font-semibold sm:flex-none`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="size-[1.05em] shrink-0 fill-current">
      <path
        d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.03-.24 11.4 11.4 0 0 0 3.56.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.56a1 1 0 0 1-.25 1.03l-2.2 2.2Z"
      ></path>
    </svg>
    Call
  </a>
</div>
