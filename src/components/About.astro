---
import { company, leadership, brands } from '../data/site';
import Section from './Section.astro';
---

<Section id="about" eyebrow="About" title="Short version." tone="surface">
  <div class="mt-8 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
    <div class="max-w-xl">
      <p class="text-lg leading-relaxed text-ink-muted">
        {company.name} has manufactured knitwear in {company.city} since {company.established}. It is
        a {company.legalStatus.toLowerCase()}, employing {company.employees} people, selling
        {company.alsoTrading.map((t) => t.toLowerCase()).join(' and ')} and supplying bulk orders by
        road across India.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink-muted">
        Top wear is made under {brands.zonixa.name}, bottom wear under {brands.msp.name}. Both are
        owned and produced in house, which is why a single order can cover both.
      </p>

      <dl class="mt-8 divide-y divide-line border-y border-line">
        {
          leadership.map((p) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3.5">
              <dt class="text-sm text-ink-muted">{p.role}</dt>
              <dd class="text-sm font-semibold text-ink">{p.name}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="lg:pt-2">
      <div class="rounded-sm border border-line bg-paper p-5">
        <h3 class="eyebrow">HSN codes</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          For your purchase and customs paperwork.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            company.hsnCodes.map((code) => (
              <li class="rounded-sm border border-line bg-surface-2 px-3 py-1.5 font-mono text-sm text-ink">
                {code}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>
